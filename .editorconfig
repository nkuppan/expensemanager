# Editor + ktlint settings (ktlint 1.x reads these via Spotless).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
# Android Studio's Kotlin style, closest to what ktlint 0.48 enforced here, instead of the much
# stricter ktlint_official default of ktlint 1.x.
ktlint_code_style = android_studio
max_line_length = 120
# Allow trailing commas, but don't force them onto every call site.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Rules ktlint 1.x added that can't be auto-fixed and would fail spotlessCheck across the
# existing codebase. Re-enable one at a time when there is time to clean up.
ktlint_standard_filename = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_backing-property-naming = disabled
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_max-line-length = disabled
ktlint_standard_comment-wrapping = disabled
ktlint_standard_discouraged-comment-location = disabled

[*.{xml,json,yml,yaml}]
indent_size = 4
